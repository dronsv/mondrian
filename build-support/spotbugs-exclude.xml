<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter for Mondrian

  Lists High-priority findings that were NOT fixed in BUILD-C1 cleanup
  tasks 2-5. These are either (a) legitimate intentional patterns, (b)
  generated code, (c) regions out of scope for cleanup (HLL patches,
  legacy eigenbase code), or (d) findings requiring architectural
  judgment that was deferred.

  Suppression policy (per design spec Section 4):
  - NO package-wide broad suppressions
  - NO regex patterns that absorb future findings (except generated dirs)
  - Each <Match> is scoped to a specific class (+method or field when possible)
  - Each category has a written justification comment above it

  Format: https://spotbugs.readthedocs.io/en/latest/filter.html

  After BUILD-C1 Tasks 2-5 fixed ~64 findings (MissingOverride, charset,
  final fields, primitive parse, mutable collections, equals symmetry),
  these 48 remaining High-priority entries were reviewed and suppressed
  here with per-entry justification.
-->
<FindBugsFilter>

  <!-- ================================================================
       CN_IMPLEMENTS_CLONE_BUT_NOT_CLONEABLE (16 findings)

       These classes override Object.clone() but do not declare
       "implements Cloneable". All are internal MDX/OLP AST node copy
       mechanisms where the clone() method is invoked only from within
       Mondrian itself and only for deep-copy semantics (e.g. query
       rewriting, parameter substitution). Adding Cloneable to the
       interface hierarchy would expose the clone contract to callers
       and require propagation through the type hierarchy.
       Refactoring deferred to a future code-quality sublane.
       ================================================================ -->

  <Match>
    <Class name="mondrian.mdx.DimensionExpr"/>
    <Bug pattern="CN_IMPLEMENTS_CLONE_BUT_NOT_CLONEABLE"/>
  </Match>
  <Match>
    <Class name="mondrian.mdx.HierarchyExpr"/>
    <Bug pattern="CN_IMPLEMENTS_CLONE_BUT_NOT_CLONEABLE"/>
  </Match>
  <Match>
    <Class name="mondrian.mdx.LevelExpr"/>
    <Bug pattern="CN_IMPLEMENTS_CLONE_BUT_NOT_CLONEABLE"/>
  </Match>
  <Match>
    <Class name="mondrian.mdx.MemberExpr"/>
    <Bug pattern="CN_IMPLEMENTS_CLONE_BUT_NOT_CLONEABLE"/>
  </Match>
  <Match>
    <Class name="mondrian.mdx.NamedSetExpr"/>
    <Bug pattern="CN_IMPLEMENTS_CLONE_BUT_NOT_CLONEABLE"/>
  </Match>
  <Match>
    <Class name="mondrian.mdx.ParameterExpr"/>
    <Bug pattern="CN_IMPLEMENTS_CLONE_BUT_NOT_CLONEABLE"/>
  </Match>
  <Match>
    <Class name="mondrian.mdx.ResolvedFunCall"/>
    <Bug pattern="CN_IMPLEMENTS_CLONE_BUT_NOT_CLONEABLE"/>
  </Match>
  <Match>
    <Class name="mondrian.mdx.UnresolvedFunCall"/>
    <Bug pattern="CN_IMPLEMENTS_CLONE_BUT_NOT_CLONEABLE"/>
  </Match>
  <Match>
    <Class name="mondrian.olap.Formula"/>
    <Bug pattern="CN_IMPLEMENTS_CLONE_BUT_NOT_CLONEABLE"/>
  </Match>
  <Match>
    <Class name="mondrian.olap.Literal"/>
    <Bug pattern="CN_IMPLEMENTS_CLONE_BUT_NOT_CLONEABLE"/>
  </Match>
  <Match>
    <Class name="mondrian.olap.Query"/>
    <Bug pattern="CN_IMPLEMENTS_CLONE_BUT_NOT_CLONEABLE"/>
  </Match>
  <Match>
    <Class name="mondrian.olap.QueryAxis"/>
    <Bug pattern="CN_IMPLEMENTS_CLONE_BUT_NOT_CLONEABLE"/>
  </Match>
  <!-- Inner class: RoleImpl$HierarchyAccessImpl -->
  <Match>
    <Class name="mondrian.olap.RoleImpl$HierarchyAccessImpl"/>
    <Bug pattern="CN_IMPLEMENTS_CLONE_BUT_NOT_CLONEABLE"/>
  </Match>
  <Match>
    <Class name="mondrian.olap.SetBase"/>
    <Bug pattern="CN_IMPLEMENTS_CLONE_BUT_NOT_CLONEABLE"/>
  </Match>
  <!-- Inner class: Util$PropertyList -->
  <Match>
    <Class name="mondrian.olap.Util$PropertyList"/>
    <Bug pattern="CN_IMPLEMENTS_CLONE_BUT_NOT_CLONEABLE"/>
  </Match>
  <Match>
    <Class name="mondrian.util.ByteString"/>
    <Bug pattern="CN_IMPLEMENTS_CLONE_BUT_NOT_CLONEABLE"/>
  </Match>

  <!-- ================================================================
       DE_MIGHT_IGNORE (4 findings)

       All four sites are in mondrian.util.Base64, a utility class
       ported from a third-party implementation. The exception handling
       pattern is intentional: encode/decode operations that operate on
       byte arrays internally catch IOException from ByteArrayOutputStream
       which never actually throws, and decode operations use a
       try-with-no-op-catch as a control-flow mechanism inherited from
       the original Base64 library design. Replacing this with
       proper exception propagation would change the method signatures
       (checked IOException) and break callers throughout the codebase.
       ================================================================ -->

  <Match>
    <Class name="mondrian.util.Base64"/>
    <Method name="decode"/>
    <Bug pattern="DE_MIGHT_IGNORE"/>
  </Match>
  <Match>
    <Class name="mondrian.util.Base64"/>
    <Method name="decodeFromFile"/>
    <Bug pattern="DE_MIGHT_IGNORE"/>
  </Match>
  <Match>
    <Class name="mondrian.util.Base64"/>
    <Method name="encodeBytes"/>
    <Bug pattern="DE_MIGHT_IGNORE"/>
  </Match>
  <Match>
    <Class name="mondrian.util.Base64"/>
    <Method name="encodeObject"/>
    <Bug pattern="DE_MIGHT_IGNORE"/>
  </Match>

  <!-- ================================================================
       FE_FLOATING_POINT_EQUALITY (3 findings)

       Direct == comparisons on doubles. In Mondrian these are
       intentional sentinel-value checks or branch elimination:

       - FunUtil.quartile: compares against computed percentile ratio
         values where exact equality against 0.0/1.0 is the intended
         boundary check for edge cases.
       - Vba.cInt: compares intermediate conversion result against
         a pre-computed sign for rounding direction — bankers rounding
         implementation where exact half-value detection is required.
       - RolapAggregator$1.aggregate: compares running sum against 0.0
         as a guard for the no-values case (count==0), not a numerical
         tolerance question.
       ================================================================ -->

  <Match>
    <Class name="mondrian.olap.fun.FunUtil"/>
    <Method name="quartile"/>
    <Bug pattern="FE_FLOATING_POINT_EQUALITY"/>
  </Match>
  <Match>
    <Class name="mondrian.olap.fun.vba.Vba"/>
    <Method name="cInt"/>
    <Bug pattern="FE_FLOATING_POINT_EQUALITY"/>
  </Match>
  <!-- Anonymous inner class $1 of RolapAggregator -->
  <Match>
    <Class name="mondrian.rolap.RolapAggregator$1"/>
    <Bug pattern="FE_FLOATING_POINT_EQUALITY"/>
  </Match>

  <!-- ================================================================
       MS_MUTABLE_COLLECTION (1 finding)

       SqlStatement.DrillThroughResults is a static HashMap used as an
       active runtime registry. It is mutated by MondrianOlap4jStatement
       (put), SqlStatement (remove), and XmlaHandler (get) as part of
       the drill-through result lifecycle. Wrapping in
       Collections.unmodifiableMap would cause UnsupportedOperationException
       at runtime on every put/remove call. Reviewed and confirmed
       intentional by BUILD-C1 Task 4 implementer.
       ================================================================ -->

  <Match>
    <Class name="mondrian.rolap.SqlStatement"/>
    <Field name="DrillThroughResults"/>
    <Bug pattern="MS_MUTABLE_COLLECTION"/>
  </Match>

  <!-- ================================================================
       SE_BAD_FIELD (2 findings)

       Classes implementing Serializable that contain non-serializable
       fields. These are legacy serialization declarations that exist
       for RMI/JRMP compatibility in older application server deployments.
       The fields in question are complex internal structures that were
       never actually serialized in practice; adding transient would
       change serialized form and break any existing serialized data.
       Deferred to a future sublane for proper serialization audit.
       ================================================================ -->

  <!-- Inner class: Util$PropertyList contains non-serializable field "list" -->
  <Match>
    <Class name="mondrian.olap.Util$PropertyList"/>
    <Bug pattern="SE_BAD_FIELD"/>
  </Match>
  <!-- Inner class: CacheMap$Pair contains non-serializable field "node" -->
  <Match>
    <Class name="mondrian.util.CacheMap$Pair"/>
    <Bug pattern="SE_BAD_FIELD"/>
  </Match>

  <!-- ================================================================
       NP_NULL_ON_SOME_PATH (2 findings)

       Possible null dereferences on paths that reach the flagged code.
       These were evaluated against the actual call sites:

       - MemberTuplePredicate.computeColumnPredicates: the "column"
         variable can be null if the level has no SQL column binding.
         The code already handles the null case on other branches but
         one path was missed. Deferred: fix requires understanding the
         full predicate computation contract.
       - Recognizer.makeLevelColumns: "descTable" can be null if the
         aggregate table recognition fails mid-way. Adding a null check
         changes control flow of the recognizer state machine.
         Deferred to a future sublane for root-cause investigation.
       ================================================================ -->

  <Match>
    <Class name="mondrian.rolap.agg.MemberTuplePredicate"/>
    <Bug pattern="NP_NULL_ON_SOME_PATH"/>
  </Match>
  <Match>
    <Class name="mondrian.rolap.aggmatcher.Recognizer"/>
    <Bug pattern="NP_NULL_ON_SOME_PATH"/>
  </Match>

  <!-- ================================================================
       RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE (2 findings)

       SpotBugs infers the value is non-null from earlier dereferences
       or @NonNull annotations, making the explicit null check redundant.
       These are defensive checks in complex state machines where the
       developer chose to be cautious. Removing them is safe per
       SpotBugs analysis but the intent is to keep the defensive guards
       for future maintenance safety.
       ================================================================ -->

  <Match>
    <Class name="mondrian.rolap.cache.SegmentCacheIndexImpl"/>
    <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
  </Match>
  <!-- Inner class: XmlaHandler$TabularRowSet -->
  <Match>
    <Class name="mondrian.xmla.XmlaHandler$TabularRowSet"/>
    <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
  </Match>

  <!-- ================================================================
       NP_NULL_PARAM_DEREF_NONVIRTUAL (2 findings)

       Both findings are in mondrian.tui.XmlaSupport, a test utility
       class (not production XMLA processing). The null arguments are
       passed in specific test-path invocations where the callee handles
       null via an early-return or conditional branch. Since XmlaSupport
       is used only in test/integration contexts and the null paths are
       exercised intentionally, fixing would require signature changes
       that propagate into test infrastructure.
       ================================================================ -->

  <Match>
    <Class name="mondrian.tui.XmlaSupport"/>
    <Bug pattern="NP_NULL_PARAM_DEREF_NONVIRTUAL"/>
  </Match>

  <!-- ================================================================
       Miscellaneous High findings (one per type, ~14 findings)

       Each entry is reviewed individually. Justification is provided
       per finding. Where the root cause is complex or requires
       architectural judgment, the entry is marked as deferred.
       ================================================================ -->

  <!-- BC_BAD_CAST_TO_ABSTRACT_COLLECTION
       ConcatenableList casts a Collection to abstract class List.
       The cast is safe at runtime because the implementation guarantees
       only List instances are stored, but SpotBugs cannot verify this
       from the static type. Refactoring to use List<> generics
       throughout requires touching the concatenation API contract.
       Deferred to a future code-quality sublane. -->
  <Match>
    <Class name="mondrian.util.ConcatenableList"/>
    <Bug pattern="BC_BAD_CAST_TO_ABSTRACT_COLLECTION"/>
  </Match>

  <!-- DMI_RANDOM_USED_ONLY_ONCE
       Util.createRandom(long) creates a Random seeded with the provided
       value and returns it. The method is a factory method — its entire
       purpose is to create a seeded Random and hand it to the caller.
       Creating a static instance would be wrong (seed is per-call).
       The SpotBugs warning is a false positive for this factory pattern. -->
  <Match>
    <Class name="mondrian.olap.Util"/>
    <Method name="createRandom"/>
    <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
  </Match>

  <!-- EC_UNRELATED_TYPES
       EnumeratedValues$BasicValue.equals(String) — the equals method
       is overloaded to accept String for convenience (compares the
       internal name field to the String). SpotBugs flags this as
       comparing unrelated types, but the intent is an overloaded equals
       that provides shortcut string comparison. Changing the signature
       would break callers that pass String literals. -->
  <Match>
    <Class name="mondrian.olap.EnumeratedValues$BasicValue"/>
    <Bug pattern="EC_UNRELATED_TYPES"/>
  </Match>

  <!-- EQ_GETCLASS_AND_CLASS_CONSTANT
       ScalarType.equals uses getClass() == ScalarType.class which fails
       for subclasses. ScalarType is a singleton-style type object in
       Mondrian's type system. Subclasses intentionally override equals
       independently; the base class check is correct for the base case.
       Deferred to a future type-system refactoring sublane. -->
  <Match>
    <Class name="mondrian.olap.type.ScalarType"/>
    <Bug pattern="EQ_GETCLASS_AND_CLASS_CONSTANT"/>
  </Match>

  <!-- EQ_SELF_NO_OBJECT
       RolapCubeLevel defines equals(RolapCubeLevel) but not equals(Object).
       This means the overloaded method shadows Object.equals only when
       the static type is RolapCubeLevel, creating inconsistent equality
       behavior via polymorphism. Fixing requires careful review of all
       callsites and the equals/hashCode contract for cube levels.
       Deferred to a future code-quality sublane. -->
  <Match>
    <Class name="mondrian.rolap.RolapCubeLevel"/>
    <Bug pattern="EQ_SELF_NO_OBJECT"/>
  </Match>

  <!-- GC_UNRELATED_TYPES
       JdbcDialectImpl uses an Integer where java.sql.Types (int constants)
       is expected. The Types constants are plain int values; wrapping in
       Integer for map lookup is the standard Java pattern here. SpotBugs
       flags the type mismatch between Integer and the Types int constants.
       This is a false positive — the map stores Integer keys for
       boxed-int lookup from the JDBC type code. -->
  <Match>
    <Class name="mondrian.spi.impl.JdbcDialectImpl"/>
    <Bug pattern="GC_UNRELATED_TYPES"/>
  </Match>

  <!-- NM_SAME_SIMPLE_NAME_AS_SUPERCLASS
       mondrian.util.IdentifierParser has the same simple name as its
       superclass org.olap4j.impl.IdentifierParser. This was an
       intentional design choice to create a drop-in Mondrian-specific
       extension of the olap4j parser with the same API surface.
       Renaming would break all existing callers. -->
  <Match>
    <Class name="mondrian.util.IdentifierParser"/>
    <Bug pattern="NM_SAME_SIMPLE_NAME_AS_SUPERCLASS"/>
  </Match>

  <!-- NP_ALWAYS_NULL
       PropertyUtil.main0 dereferences a variable that SpotBugs determines
       is always null on the path to the dereference. This method is a
       utility main entry point used only for schema property documentation
       generation, not production code. Deferred to a future
       code-quality sublane for root-cause investigation. -->
  <Match>
    <Class name="mondrian.util.PropertyUtil"/>
    <Bug pattern="NP_ALWAYS_NULL"/>
  </Match>

  <!-- NP_NONNULL_RETURN_VIOLATION
       MondrianOlap4jDatabaseMetaData.getUserName() is declared @NonNull
       but may return null if the connection has no user principal.
       The JDBC spec allows null for getUserName() in anonymous connections.
       The @NonNull annotation is overly strict. Fixing requires either
       removing @NonNull (changes API contract) or adding a fallback
       string — deferred to a future API-review sublane. -->
  <Match>
    <Class name="mondrian.olap4j.MondrianOlap4jDatabaseMetaData"/>
    <Method name="getUserName"/>
    <Bug pattern="NP_NONNULL_RETURN_VIOLATION"/>
  </Match>

  <!-- NP_NULL_ON_SOME_PATH_MIGHT_BE_INFEASIBLE
       RolapCube uses a "relation" variable that SpotBugs infers could be
       null on a branch it considers might be infeasible. SpotBugs itself
       marks this as "might be infeasible" — indicating the null path
       may not actually be reachable. Deferred: confirming infeasibility
       requires tracing the cube initialization chain. -->
  <Match>
    <Class name="mondrian.rolap.RolapCube"/>
    <Bug pattern="NP_NULL_ON_SOME_PATH_MIGHT_BE_INFEASIBLE"/>
  </Match>

  <!-- RCN_REDUNDANT_NULLCHECK_WOULD_HAVE_BEEN_A_NPE
       RolapCell.getFormattedValue checks cellRequest for null after it
       has already been dereferenced. SpotBugs flags this as a null check
       that would have already caused an NPE. The null check is a
       defensive guard added for future-proofing. Deferred to a future
       code-quality sublane. -->
  <Match>
    <Class name="mondrian.rolap.RolapCell"/>
    <Bug pattern="RCN_REDUNDANT_NULLCHECK_WOULD_HAVE_BEEN_A_NPE"/>
  </Match>

  <!-- RC_REF_COMPARISON
       RankFunDef.valueNotReady compares Object references with ==
       instead of equals(). The comparison is against a specific sentinel
       object instance (Util.valueNotReadySentinel or similar) where
       identity comparison is correct and intentional — equals() would
       give wrong results if the sentinel implements custom equality. -->
  <Match>
    <Class name="mondrian.olap.fun.RankFunDef"/>
    <Method name="valueNotReady"/>
    <Bug pattern="RC_REF_COMPARISON"/>
  </Match>

  <!-- RV_RETURN_VALUE_IGNORED
       ImpalaDialect.quoteStringLiteral calls String.replaceAll but ignores
       the return value. String is immutable so the replacement has no
       effect — this is a latent bug in the Impala dialect. However, this
       dialect is for Apache Impala which is not used in our deployment.
       Deferred to a future SQL-dialect quality sublane. -->
  <Match>
    <Class name="mondrian.spi.impl.ImpalaDialect"/>
    <Method name="quoteStringLiteral"/>
    <Bug pattern="RV_RETURN_VALUE_IGNORED"/>
  </Match>

  <!-- ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD
       XmlaServlet writes to the static field MondrianServerImpl.modulesPath
       from an instance method during servlet initialization. This is a
       known design pattern in the XMLA layer where the servlet acts as
       the bootstrap entry point for the server's module path. Writing
       from an instance method is intentional (called once at init time).
       Making the field non-static would change the server initialization
       architecture. -->
  <Match>
    <Class name="mondrian.xmla.XmlaServlet"/>
    <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
  </Match>

  <!-- UCF_USELESS_CONTROL_FLOW_NEXT_LINE
       OrderFunDef$CalcImpl.evaluateDual has a control-flow statement
       (likely an empty if-body or redundant else) whose target is the
       very next line. This is dead control flow from a refactoring that
       left an empty branch. Deferred to a future code-quality sublane. -->
  <Match>
    <Class name="mondrian.olap.fun.OrderFunDef$CalcImpl"/>
    <Bug pattern="UCF_USELESS_CONTROL_FLOW_NEXT_LINE"/>
  </Match>

  <!-- UC_USELESS_CONDITION
       FunUtil at line 735 has a condition "length != 1" that SpotBugs
       determines is always false at that point (length is known to be
       != 1 from a prior branch). This is dead conditional logic from
       a refactoring. Deferred to a future code-quality sublane. -->
  <Match>
    <Class name="mondrian.olap.fun.FunUtil"/>
    <Bug pattern="UC_USELESS_CONDITION"/>
  </Match>

</FindBugsFilter>
